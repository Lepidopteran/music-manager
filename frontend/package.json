		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/estree": "^1.0.9",
		"@types/node": "^26.6.4",
		"@vitest/browser-playwright": "^4.1.11",
		"dprint": "^0.56.1",
